{
  "name": "optionmap",
  "version": "1.1.0-beta.7",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "OptionMap - Nikkei 225 options and futures market analysis",
  "build": {
    "appId": "com.natsu.optionmap",
    "productName": "OptionMap",
    "artifactName": "OptionMap-${version}-win-${arch}.${ext}",
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "style.css",
      "js/**/*",
      "scripts/marketCalendarReadOnlyProbe.html",
      "scripts/marketCalendarReadOnlyProbeEarly.js",
      "scripts/marketCalendarReadOnlyProbe.js",
      "scripts/marketCalendarReadOnlyProbeBoot.js",
      "scripts/marketCalendarReadOnlyAuditReportPreload.js",
      "scripts/marketCalendarReadOnlySchema.js",
      "scripts/marketCalendarG14bFilesystemGuard.js",
      "scripts/marketCalendarD2d4ReadOnlyProbe.html",
      "!js/script2026807.js",
      "!js/script_v0.92.js",
      "!.env",
      "!.env.*",
      "!test{,/**/*}",
      "!.github{,/**/*}",
      "!docs{,/**/*}",
      "!README*",
      "!ROADMAP*",
      "!IDEAS*",
      "!OptionMap.code-workspace",
      "!data{,/**/*}",
      "!dist{,/**/*}",
      "!**/.DS_Store"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "build/installer-upgrade-compat.nsh"
    }
  },
  "devDependencies": {
    "electron": "42.5.1",
    "electron-builder": "^26.15.3",
    "fake-indexeddb": "^6.2.5"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "dotenv": "^17.4.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
